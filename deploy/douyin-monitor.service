[Unit]
Description=Guanchao Douyin Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=douyin-monitor
Group=douyin-monitor
WorkingDirectory=/opt/douyin-monitor
EnvironmentFile=/opt/douyin-monitor/deploy/server.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Shanghai
ExecStart=/opt/douyin-monitor/.venv/bin/python /opt/douyin-monitor/src/app.py --no-browser
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=append:/opt/douyin-monitor/logs/server.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
